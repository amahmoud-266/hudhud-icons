node.hz_icon["sign_type"=~/^restriction=no_stopping$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^restriction=no_u_turn$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^restriction=only_left_turn$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^restriction=only_right_turn$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^restriction=only_straight_on$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^traffic_calming=bump$/] { icon-image: "data:image/png;base64,"; }

/* Labels */
node.hz_label {
    text-color: setting("label_color");
    text-halo-color: black;
    text-halo-radius: 2;
    text-offset-y: 25;
    font-size: eval(setting("font_size"));
}
node.hz_label[!sign_type]["Data"=~/^HH$/] { text: "Data=HH"; }
node.hz_label[!sign_type]["Data"=~/^HH$/][setting("label_short")] { text: "HH"; }
node.hz_label[sign_type] { text: eval(tag("sign_type")); }
node.hz_label[sign_type][setting("label_short")] { text: eval(any(get(regexp_match("^.*=(.*)$", tag("sign_type")), 1), tag("sign_type"))); }

