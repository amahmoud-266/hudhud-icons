meta {
    title: "Hudhud";
    version: "5.0";
    description: "Hudhud signs. Icons are embedded in this file (fast, no downloads). Right-click > Style settings.";
    author: "Hudhud Team";
    icon: "data:image/png;base64,";
}

/* ============================================================
   ORIGINAL RULES (unchanged, kept exactly as in the source file)
   ============================================================ */

/* 1. Speed Bumps */
node|z16-[traffic_calming=bump] {
    icon-image: "data:image/png;base64,";
    icon-width: 30;
    icon-height: 30;
    icon-opacity: 1.0;

    text: "bump";
    text-color: white;
    text-halo-color: black;
    text-halo-radius: 2;
    text-offset-y: 25;
    font-size: 13;
}

/* 2. Rumble Strips */
node|z16-[traffic_calming=rumble_strip] {
    icon-image: "data:image/png;base64,";
    icon-width: 30;
    icon-height: 30;
    icon-opacity: 1.0;

    text: "Rumble Strip";
    text-color: white;
    text-halo-color: black;
    text-halo-radius: 2;
    text-offset-y: 22;
    font-size: 13;
}

/* 3. Pedestrian Crossings */
node|z16-[highway=crossing] {
    icon-image: "data:image/png;base64,";
    icon-width: 35;
    icon-height: 35;
    icon-opacity: 1.0;

    text: "Pedestrian Crossing";
    text-color: yellow;
    text-halo-color: black;
    text-halo-radius: 2;
    text-offset-y: 25;
    font-size: 13;
}

/* 4. Enforcement Camera (Phone & Seatbelt) */
node|z16-[type=enforcement][enforcement="mobile_phone;seatbelt"] {
    icon-image: "data:image/png;base64,";
    icon-width: 35;
    icon-height: 35;
    icon-opacity: 1.0;

    text: "Camera: Phone/Seatbelt";
    text-color: #ff0000;
    text-halo-color: white;
    text-halo-radius: 2;
    text-offset-y: 25;
    font-size: 12;
}

/* 5. Speed Camera */
node|z16-[highway=speed_camera] {
    icon-image: "data:image/png;base64,";
    icon-width: 35;
    icon-height: 35;
    icon-opacity: 1.0;

    text: "Speed Camera";
    text-color: #ff0000;
    text-halo-color: white;
    text-halo-radius: 2;
    text-offset-y: 25;
    font-size: 12;
}

/* 6. Disabled Parking Space */
node|z16-[amenity=parking_space][parking_space=disabled] {
    icon-image: "data:image/png;base64,";
    icon-width: 35;
    icon-height: 35;
    icon-opacity: 1.0;

    text: "Disabled Parking";
    text-color: #00aaff;
    text-halo-color: white;
    text-halo-radius: 2;
    text-offset-y: 25;
    font-size: 12;
}

/* 7. Barrier Block */
node|z16-[barrier=block] {
    icon-image: "data:image/png;base64,";
    icon-width: 35;
    icon-height: 35;
    icon-opacity: 1.0;

    text: "Barrier Block";
    text-color: #ffffff;
    text-halo-color: #555555;
    text-halo-radius: 2;
    text-offset-y: 25;
    font-size: 12;
}

/* ============================================================
   STYLE SETTINGS  (JOSM: right-click the style > Style settings)
   Numbers: click the item and type a new value.
   ============================================================ */
setting::icon_zoom {
    type: double;
    label: tr("🖼 Icons | Show from zoom level (14-18)");
    default: 16;
}
setting::icon_size {
    type: double;
    label: tr("🖼 Icons | Size in pixels (e.g. 20-60)");
    default: 30;
}
setting::icon_opacity {
    type: double;
    label: tr("🖼 Icons | Opacity (0.1 - 1.0)");
    default: 1.0;
}
setting::show_labels {
    type: boolean;
    label: tr("🔤 Text | Show text");
    default: true;
}
setting::label_zoom {
    type: double;
    label: tr("🔤 Text | Show from zoom level (16-19)");
    default: 16;
}
setting::label_short {
    type: boolean;
    label: tr("🔤 Text | Short text (stop instead of highway=stop)");
    default: false;
}
setting::font_size {
    type: double;
    label: tr("🔤 Text | Size");
    default: 11;
}
setting::label_color {
    type: color;
    label: tr("🔤 Text | Color");
    default: #ffffff;
}

/* ============================================================
   GENERATED BY tools/build_hudhud_style.py  -  DO NOT EDIT BY HAND
   To add a sign: upload  <key>=<value>.png  to the AI or Basic folder
   on GitHub (e.g. QC=Done.png, sign_type=highway=stop.png).
   Any node with that tag gets the image. sign_type wins over other tags.
   ============================================================ */

/* Nodes that have a tag with an image (+ any sign_type, for unKnown) */
node[sign_type],
node["Data"=~/^HH$/] { set .hz_m; }

/* Zoom switches (from Style settings) */
node|z14.hz_m[(setting("icon_zoom") <= 14)] { set .hz_icon; }
node|z15.hz_m[(setting("icon_zoom") <= 15)] { set .hz_icon; }
node|z16.hz_m[(setting("icon_zoom") <= 16)] { set .hz_icon; }
node|z17.hz_m[(setting("icon_zoom") <= 17)] { set .hz_icon; }
node|z18-.hz_m[(setting("icon_zoom") <= 18)] { set .hz_icon; }
node|z16.hz_m[setting("show_labels")][(setting("label_zoom") <= 16)] { set .hz_label; }
node|z17.hz_m[setting("show_labels")][(setting("label_zoom") <= 17)] { set .hz_label; }
node|z18.hz_m[setting("show_labels")][(setting("label_zoom") <= 18)] { set .hz_label; }
node|z19-.hz_m[setting("show_labels")][(setting("label_zoom") <= 19)] { set .hz_label; }

/* Size / opacity for every icon; "unKnown" for a sign_type without image */
node.hz_icon {
    icon-width: eval(setting("icon_size"));
    icon-height: eval(setting("icon_size"));
    icon-opacity: eval(setting("icon_opacity"));
}
node.hz_icon[sign_type] { icon-image: "data:image/png;base64,"; }

/* One rule per image */
node.hz_icon["Data"=~/^HH$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_bicycle$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_curve_left$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_curve_right$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_detour_left$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_detour_right$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_direction_other$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_merge_in_left$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_merge_in_right$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_merge_out_right$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_narrow_from_left$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_narrow_from_right$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_no_stop_or_wait_bus_stop$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_right_or_uturn$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_road_works$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_slow$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_stop_red_light$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^ai_name_straight_or_uturn$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^amenity=parking$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^detour_left_or_right$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^enforcement=maxspeed$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^enter=yes$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^exit=yes$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^hgv=no$/] { icon-image: "data:image/png;base64,"; }
node.hz_icon["sign_type"=~/^highway=bus_stop$/] { icon-image: "data:image/png;base64,"; }
